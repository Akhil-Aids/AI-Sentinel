# AI Sentinel environment configuration.
# Copy this file to `.env` and set your real secrets there. Never commit `.env`.

# --- Runtime ---------------------------------------------------------------
SENTINEL_ENV=development
SENTINEL_DEBUG=true

# --- Auth ------------------------------------------------------------------
# Strong random secret for token signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_AUTH_SECRET=development-only-change-me
SENTINEL_TOKEN_TTL=28800

# Bootstrap admin password (leave empty to generate a random one, written to
# backend/bootstrap_admin.txt on first startup).
SENTINEL_ADMIN_PASSWORD=

# Shared key used by endpoint agents to push telemetry (X-Agent-Key header).
SENTINEL_AGENT_KEY=

# --- Storage ---------------------------------------------------------------
SENTINEL_DB_PATH=
SENTINEL_RETENTION_DAYS=30

# --- Pipeline ---------------------------------------------------------------
SENTINEL_WORKERS=2
SENTINEL_QUEUE_MAXSIZE=20000

# --- ML ---------------------------------------------------------------------
SENTINEL_ML_ENABLED=true
SENTINEL_ML_RETRAIN_MIN_SAMPLES=200
SENTINEL_ML_CONTAMINATION=0.05

# --- Phishing ---------------------------------------------------------------
SENTINEL_PHISHING_ENABLED=true

# --- Threat intelligence (optional) -----------------------------------------
SENTINEL_TI_ENABLED=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- Response engine --------------------------------------------------------
# Keep true until integrations are configured. When true, destructive actions
# are blocked and recorded instead of executed.
SENTINEL_RESPONSE_DRY_RUN=true

# --- Frontend CORS ----------------------------------------------------------
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Monitored directories for file-change detection (semicolon-separated) ---
# SENTINEL_MONITOR_DIRS=

# --- Demo mode --------------------------------------------------------------
# Explicitly OFF unless you want clearly-labelled simulated data.
SENTINEL_DEMO_MODE=false
