# AI Sentinel environment configuration.
# Copy this file to `.env` and set your real secrets there. Never commit `.env`.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Runtime ---------------------------------------------------------------
SENTINEL_ENV=development
SENTINEL_ENVIRONMENT=development
SENTINEL_DEBUG=false

# --- Auth ------------------------------------------------------------------
# Strong random secret for token signing (required in production).
SENTINEL_AUTH_SECRET=
SENTINEL_TOKEN_TTL=28800

# Bootstrap admin password (leave empty to generate a random one, written to
# backend/bootstrap_admin.txt on first startup).
SENTINEL_ADMIN_PASSWORD=

# Shared key used by endpoint agents to push telemetry (X-Agent-Key header).
SENTINEL_AGENT_KEY=

# --- Storage ---------------------------------------------------------------
SENTINEL_DB_PATH=
SENTINEL_RETENTION_DAYS=30

# --- Pipeline ---------------------------------------------------------------
SENTINEL_WORKERS=2
SENTINEL_QUEUE_MAXSIZE=20000

# --- Event lifecycle latency targets (ms) -----------------------------------
SENTINEL_LATENCY_TARGET_EVENT_MS=2000
SENTINEL_LATENCY_TARGET_CRITICAL_MS=5000

# --- Telemetry collector intervals (seconds) --------------------------------
SENTINEL_METRICS_INTERVAL=15
SENTINEL_FILE_INTERVAL=30

# --- Agent heartbeat thresholds (seconds) -----------------------------------
SENTINEL_AGENT_DEGRADED_SECONDS=45
SENTINEL_AGENT_OFFLINE_SECONDS=120

# --- ML ---------------------------------------------------------------------
SENTINEL_ML_ENABLED=true
SENTINEL_ML_RETRAIN_MIN_SAMPLES=200
SENTINEL_ML_CONTAMINATION=0.05
SENTINEL_MODEL_DIR=

# --- Phishing ---------------------------------------------------------------
SENTINEL_PHISHING_ENABLED=true

# --- Threat intelligence (optional) -----------------------------------------
SENTINEL_TI_ENABLED=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- Response engine --------------------------------------------------------
# Keep true until integrations are configured. When true, destructive actions
# are blocked and recorded instead of executed.
SENTINEL_RESPONSE_DRY_RUN=true

# --- Backup protection (semicolon-separated absolute paths) -----------------
SENTINEL_BACKUP_TARGETS=

# --- Network trust ----------------------------------------------------------
# Comma-separated proxy IPs whose X-Forwarded-For is trusted.
SENTINEL_TRUSTED_PROXIES=

# --- Frontend CORS ----------------------------------------------------------
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Monitored directories for file-change detection (semicolon-separated) ---
SENTINEL_MONITOR_DIRS=

# --- Demo mode --------------------------------------------------------------
# Explicitly OFF unless you want clearly-labelled simulated data.
SENTINEL_DEMO_MODE=false

# --- Standalone Agent (used by `python -m agent`) ---------------------------
SENTINEL_AGENT_SERVER_URL=http://localhost:8000
SENTINEL_AGENT_HOSTNAME=
SENTINEL_AGENT_HEARTBEAT_INTERVAL=30
SENTINEL_AGENT_COLLECT_INTERVAL=15
SENTINEL_AGENT_RETRY_BASE_DELAY=2.0
SENTINEL_AGENT_RETRY_MAX_DELAY=60.0
SENTINEL_AGENT_BUFFER_MAX=500
SENTINEL_AGENT_FLUSH_BATCH_SIZE=100
SENTINEL_AGENT_PROTECTED_DIRS=/etc,/usr,/var
SENTINEL_AGENT_FILE_CHECK_INTERVAL=5.0

# --- LLM Integration (for SOC assistant) ------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
